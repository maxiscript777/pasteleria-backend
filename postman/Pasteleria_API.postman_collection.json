    {
      "name": "01 Login admin",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"correo\": \"admin@duoc.cl\",\n  \"clave\": \"admin123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado 200\", () => pm.response.to.have.status(200));",
              "const r = pm.response.json();",
              "pm.test(\"Trae token\", () => pm.expect(r.accessToken).to.be.a(\"string\"));",
              "pm.collectionVariables.set(\"tokenAdmin\", r.accessToken);"
            ]
          }
        }
      ]
    },
